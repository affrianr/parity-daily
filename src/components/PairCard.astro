---
import { getCurrency } from "@/lib/currencies";
import { formatRate } from "@/lib/format";

interface Props {
  from: string;
  to: string;
  rate: number | null;
  delta?: number;
  span: "wide" | "narrow" | "tall";
  imageSeed: string;
}

const { from, to, rate, delta = 0, span, imageSeed } = Astro.props;
const fromMeta = getCurrency(from);
const toMeta = getCurrency(to);

const spanClass =
  span === "wide"
    ? "md:col-span-2"
    : span === "tall"
      ? "md:row-span-2"
      : "";

const trend = delta > 0 ? "up" : delta < 0 ? "down" : "flat";
const trendLabel =
  trend === "up" ? `+${(delta * 100).toFixed(2)}%` :
  trend === "down" ? `${(delta * 100).toFixed(2)}%` :
  "—";
const trendColor =
  trend === "up" ? "text-lime-accent" :
  trend === "down" ? "text-orange-300" :
  "text-bone-400";

const href = `/?from=${from}&to=${to}&amount=100#convert`;
---
<a
  href={href}
  class={`group relative overflow-hidden rounded-3xl border border-bone-50/8 bg-ink-900/60 p-6 transition-all duration-500 hover:border-lime-accent/30 hover:-translate-y-1 ${spanClass}`}
  data-reveal
>
  <div
    class="absolute inset-0 opacity-25 transition-all duration-700 group-hover:opacity-40 group-hover:scale-105"
    style={`background-image: url('https://picsum.photos/seed/${imageSeed}/1200/900'); background-size: cover; background-position: center; filter: grayscale(1) contrast(1.15) brightness(0.55); mix-blend-mode: luminosity;`}
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-tr from-ink-950 via-ink-950/85 to-ink-950/30" aria-hidden="true"></div>

  <div class="relative flex h-full flex-col justify-between gap-8">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-2 font-mono-tabular text-xs uppercase tracking-wide-meta text-bone-300">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-bone-50/8 text-[9px] font-semibold text-bone-100">{fromMeta.flag}</span>
        <span>{from}</span>
        <span class="text-bone-500">→</span>
        <span class="grid h-6 w-6 place-items-center rounded-full bg-bone-50/8 text-[9px] font-semibold text-bone-100">{toMeta.flag}</span>
        <span>{to}</span>
      </div>
      <span class={`font-mono-tabular text-[11px] ${trendColor}`}>{trendLabel}</span>
    </div>

    <div>
      <div class="font-mono-tabular text-[10px] uppercase tracking-wide-meta text-bone-400">
        1 {from} buys
      </div>
      <div class="font-display mt-2 text-display-md font-medium tracking-tight-display text-bone-50">
        {rate != null ? formatRate(rate) : "—"} <span class="text-bone-400">{to}</span>
      </div>
    </div>

    <div class="flex items-center gap-2 text-sm text-bone-300">
      Open converter
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
        <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
      </svg>
    </div>
  </div>
</a>
