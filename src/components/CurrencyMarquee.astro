---
const codes = ["USD", "EUR", "JPY", "GBP", "CHF", "CAD", "AUD", "CNY", "SGD", "HKD", "NZD", "SEK", "NOK", "DKK", "MXN", "BRL", "INR", "KRW", "ZAR", "TRY"];
const doubled = [...codes, ...codes];
---
<div
  data-marquee
  class="relative overflow-hidden border-y border-bone-50/8 bg-ink-950/60 py-6 gradient-mask-r"
>
  <div data-marquee-track class="flex items-center gap-12 whitespace-nowrap will-change-transform">
    {doubled.map((c, i) => (
      <span class="flex items-center gap-3 font-mono-tabular text-[11px] uppercase tracking-wide-meta text-bone-400">
        <span class="font-display text-3xl font-medium text-bone-200 tracking-tight">{c}</span>
        <span class="h-1.5 w-1.5 rounded-full bg-bone-50/20"></span>
        <span>pair {String((i % 20) + 1).padStart(2, "0")}</span>
      </span>
    ))}
  </div>
</div>
